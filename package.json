{
  "name": "@magic/tags",
  "version": "0.0.14",
  "author": "Wizards & Witches",
  "description": "exports arrays of all html and svg tags.",
  "license": "AGPL-3.0",
  "homepage": "https://magic.github.io/tags",
  "type": "module",
  "scripts": {
    "start": "t -p",
    "build": "npm run build:docs && npm run test && tsc && npm run format",
    "build:docs": "NODE_ENV=production magic build",
    "prepublishOnly": "npm run build",
    "prod": "NODE_ENV=production magic build serve --watch src",
    "clean": "magic clean",
    "serve": "magic serve",
    "dev": "magic dev --watch src",
    "format": "f -w --exclude docs",
    "test": "t --exclude docs example config.js",
    "calls": "calls",
    "tsc": "tsc --noEmit",
    "check": "npm run tsc"
  },
  "files": [
    "src",
    "types"
  ],
  "engines": {
    "node": ">=14.15.4"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic/tags.git"
  },
  "bugs": {
    "url": "https://github.com/magic/tags/issues"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "devDependencies": {
    "@magic-modules/light-switch": "0.0.12",
    "@magic-modules/no-spy": "0.0.9",
    "@magic-modules/pre": "0.0.12",
    "@magic-themes/docs": "0.0.15",
    "@magic/core": "0.0.158",
    "@magic/format": "0.0.73",
    "@magic/test": "0.3.12",
    "typescript": "6.0.3"
  },
  "keywords": [
    "html",
    "tags",
    "magic"
  ],
  "contributors": [
    {
      "name": "jascha ehrenreich",
      "github": "jaeh"
    }
  ]
}
